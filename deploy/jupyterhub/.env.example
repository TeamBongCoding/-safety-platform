# JupyterHub production server
PORT=8000
COOKIE_SECURE=1
DATABASE_URL=sqlite:///./safety.db

# Keep 0 until the model files are ready, then change to 1.
ANALYSIS_ENABLED=0
REID_DEVICE=auto
HELMET_MODEL_PATH=weights/best.pt
PERSON_MODEL_PATH=yolov8n.pt
FASTREID_WEIGHTS_PATH=backend/weights/market_bot_R50.pth

# Empty token: create a temporary https://*.trycloudflare.com URL on every start.
# Token set: run the named tunnel configured in the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# For a named tunnel, set its public URL so service.sh can display it.
PUBLIC_URL=

# Episode aggregation
EVENT_EPISODE_CLOSE_GAP_SEC=30
EVENT_EPISODE_MIN_DURATION_SEC=2
EVENT_EPISODE_UPDATE_INTERVAL_SEC=10

# Local LLM — 1GB+ VRAM 필요; .gguf 모델 파일은 Git에 추가하지 말 것
LOCAL_LLM_ENABLED=0
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_MODEL=Qwen/Qwen3-4B
LOCAL_LLM_TIMEOUT_SEC=60
LOCAL_LLM_MAX_TOKENS=1000
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_REQUIRE_SUCCESS=0

# Supabase (service-role key는 이 파일에만, Git에 커밋 금지)
# DATABASE_URL=postgresql+psycopg://postgres:[password]@db.[project].supabase.co:5432/postgres
# SUPABASE_URL=https://[project].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DOCUMENT_BUCKET=safety-documents

# RAG / Embedding
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
RAG_TOP_K=5
RAG_THRESHOLD=0.7
