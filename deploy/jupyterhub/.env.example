# JupyterHub production server
PORT=8000
COOKIE_SECURE=1

# Temporary client demo lifecycle
DEMO_IDLE_MINUTES=30
DEMO_MAX_HOURS=2
DEMO_CLEANUP_INTERVAL_SECONDS=60
DEMO_MAX_ACTIVE_SESSIONS=5
DATABASE_URL=sqlite:///./safety.db

REID_DEVICE=auto
HELMET_MODEL_PATH=weights/best.pt
PERSON_MODEL_PATH=yolov8n.pt
FASTREID_WEIGHTS_PATH=backend/weights/market_bot_R50.pth

# Empty token: create a temporary https://*.trycloudflare.com URL on every start.
# Token set: run the named tunnel configured in the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# For a named tunnel, set its public URL so service.sh can display it.
PUBLIC_URL=

# Episode aggregation
EVENT_EPISODE_CLOSE_GAP_SEC=30
EVENT_EPISODE_MIN_DURATION_SEC=2
EVENT_EPISODE_UPDATE_INTERVAL_SEC=10

# 해커톤 데모: 기존 24h/7d API를 화면에서 1분/5분으로 매핑
RISK_WINDOW_MODE=demo
RISK_REFRESH_SECONDS=5
RISK_SHORT_WINDOW_MINUTES=1
RISK_LONG_WINDOW_MINUTES=5

# OpenAI SDK (API key는 Git에서 제외된 루트 .env에만 입력)
OPENAI_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 해커톤에서 별도 OpenAI-compatible gateway URL을 제공할 때만 설정
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SEC=60
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_RETRIES=1

# Supabase (service-role key는 이 파일에만, Git에 커밋 금지)
# DATABASE_URL=postgresql+psycopg://postgres:[password]@db.[project].supabase.co:5432/postgres
# SUPABASE_URL=https://[project].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DOCUMENT_BUCKET=safety-documents

# RAG / Embedding
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=128
RAG_TOP_K=5
RAG_THRESHOLD=0.7
RAG_FALLBACK_THRESHOLD=0.35
