# JupyterHub 공개 URL (브라우저에서 접속하는 주소)
HUB_PUBLIC_URL=
# Runtime
ANALYSIS_ENABLED=0
VIDEO_SOURCE=data/videos/site1.mp4

# Backend server (used by start.ps1)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Browser client; leave empty to use the Vite proxy or same-origin deployment
VITE_API_BASE=
VITE_WS_BASE=
VITE_BACKEND_PORT=

# Backend application
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./safety.db
SESSION_COOKIE_NAME=safety_session
SESSION_DAYS=7
# 로컬 HTTP에서는 0, HTTPS 배포에서는 반드시 1
COOKIE_SECURE=0
HELMET_MODEL_PATH=weights/best.pt
PERSON_MODEL_PATH=yolov8n.pt
MODEL_CONFIDENCE=0.4
MODEL_IMAGE_SIZE=512
FONT_PATH=C:/Windows/Fonts/malgun.ttf
TRACK_MAX_MISSED_FRAMES=12

# Pose-based abnormal behavior detection
POSE_ENABLED=0
POSE_MODEL_PATH=weights/yolo11n-pose.pt
LIVE_INFER_EVERY=4
LIVE_POSE_INFER_EVERY=6

# Episode aggregation
EVENT_EPISODE_CLOSE_GAP_SEC=30
EVENT_EPISODE_MIN_DURATION_SEC=2
EVENT_EPISODE_UPDATE_INTERVAL_SEC=10

# 해커톤 데모: 기존 24h/7d API를 화면에서 1분/5분으로 매핑
RISK_WINDOW_MODE=demo
RISK_REFRESH_SECONDS=5
RISK_SHORT_WINDOW_MINUTES=1
RISK_LONG_WINDOW_MINUTES=5

# OpenAI SDK (OPENAI_API_KEY는 .env에만 저장하고 Git에 커밋하지 말 것)
OPENAI_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 해커톤에서 별도 OpenAI-compatible gateway URL을 제공할 때만 설정
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SEC=60
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_RETRIES=1

# Supabase (DB URL에는 postgresql+psycopg:// 스킴 사용, service-role key는 backend .env에만)
# DATABASE_URL=postgresql+psycopg://postgres:[password]@db.[project].supabase.co:5432/postgres
# SUPABASE_URL=https://[project].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      <- 절대 Git에 넣지 말 것
# SUPABASE_DOCUMENT_BUCKET=safety-documents
# SUPABASE_SNAPSHOT_BUCKET=event-snapshots
# SUPABASE_CLIP_BUCKET=event-clips

# RAG / Embedding
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
RAG_TOP_K=5
RAG_THRESHOLD=0.7

KMA_API_KEY=