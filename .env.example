# Runtime
ANALYSIS_ENABLED=0
VIDEO_SOURCE=data/videos/site1.mp4

# Backend server (used by start.ps1)
# 다른 PC가 Tailscale/LAN을 통해 접속할 수 있도록 모든 네트워크에서 수신
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 로컬/Tailscale 개발에서는 비워 두면 Vite가 백엔드로 프록시합니다.
# Cloudflare Pages에서는 별도로 공개된 HTTPS 백엔드 주소가 필요합니다.
VITE_API_BASE=
VITE_WS_BASE=

# Backend application
# Vite 프록시 사용 시 Tailscale IP를 추가하지 않아도 됩니다.
# 백엔드 8000 포트에 직접 접속시키는 경우 http://100.x.x.x:5173을 추가하세요.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 기본 로컬 DB. Supabase 사용 시 아래 DB_HOST~DB_PASSWORD 값을 설정하면 이 값보다 우선합니다.
DATABASE_URL=sqlite:///./safety.db
# Supabase Session pooler 예시
# DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.your-project-ref
# DB_PASSWORD=your-database-password
SESSION_COOKIE_NAME=safety_session
SESSION_DAYS=7
# 로컬 HTTP에서는 0, HTTPS 배포에서는 반드시 1
COOKIE_SECURE=0
# app.example.com + api.example.com: lax / pages.dev + unrelated API domain: none
# COOKIE_SAMESITE=none requires COOKIE_SECURE=1
COOKIE_SAMESITE=lax
HELMET_MODEL_PATH=weights/best.pt
PERSON_MODEL_PATH=yolov8n.pt
MODEL_CONFIDENCE=0.4
FONT_PATH=C:/Windows/Fonts/malgun.ttf
TRACK_MAX_MISSED_FRAMES=12
REID_MAX_TRANSITION_SECONDS=30
REID_MIN_SIMILARITY=0.60
REID_SCORE_THRESHOLD=0.68
REID_DEEP_WEIGHT=0.85
REID_IMAGE_SIZE=192
REID_ENTRY_GRACE_FRAMES=30
REID_ROI_MARGIN=0.025
REID_BACKEND=fastreid
REID_DEVICE=auto
FASTREID_WEIGHTS_PATH=backend/weights/market_bot_R50.pth
