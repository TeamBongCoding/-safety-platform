# Runtime
ANALYSIS_ENABLED=0
VIDEO_SOURCE=data/videos/site1.mp4

# Backend server (used by start.ps1)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Browser client; leave empty to use the Vite proxy or same-origin deployment
VITE_API_BASE=
VITE_WS_BASE=

# Backend application
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./safety.db
# Optional Supabase Session Pooler settings. When DB_HOST is set, these values
# take precedence over DATABASE_URL. Never commit real credentials.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
SESSION_COOKIE_NAME=safety_session
SESSION_DAYS=7
# 로컬 HTTP에서는 0, HTTPS 배포에서는 반드시 1
COOKIE_SECURE=0
HELMET_MODEL_PATH=weights/best.pt
PERSON_MODEL_PATH=yolov8n.pt
MODEL_CONFIDENCE=0.4
MODEL_IMAGE_SIZE=512
FONT_PATH=C:/Windows/Fonts/malgun.ttf
TRACK_MAX_MISSED_FRAMES=12
TRACK_STATIONARY_MAX_MISSED_FRAMES=45
TRACK_STATIONARY_DISTANCE=0.045
TRACK_OCCLUSION_IOU=0.20
TRACK_APPEARANCE_MATCH_THRESHOLD=0.72
REID_MAX_TRANSITION_SECONDS=30
REID_MIN_SIMILARITY=0.60
REID_SCORE_THRESHOLD=0.68
REID_DEEP_WEIGHT=0.85
REID_IMAGE_SIZE=192
REID_ENTRY_GRACE_FRAMES=30
REID_ROI_MARGIN=0.025
REID_BACKEND=fastreid
REID_DEVICE=auto
FASTREID_WEIGHTS_PATH=backend/weights/market_bot_R50.pth
REID_OVERLAP_THRESHOLD=0.80
REID_STRONG_MATCH_THRESHOLD=0.82
OVERLAP_TIME_TOLERANCE=2.0
OVERLAP_CONFIRM_FRAMES=5
OVERLAP_SCORE_MARGIN=0.04
EMBEDDING_HISTORY_SIZE=8
EMBEDDING_MIN_QUALITY=0.30
HELMET_VOTE_WINDOW_SECONDS=5.0

# Pose-based abnormal behavior detection
POSE_ENABLED=0
POSE_MODEL_PATH=yolo11n-pose.pt
POSE_MODEL_CONFIDENCE=0.20
POSE_IMAGE_SIZE=1280
POSE_TRACK_HOLD_FRAMES=6
POSE_TRACK_HOLD_SECONDS=1.0
POSE_LOW_PROFILE_RATIO=0.65
POSE_LOW_PROFILE_HOLD_FRAMES=20
POSE_LOW_PROFILE_HOLD_SECONDS=3.0
POSE_STATE_HOLD_SECONDS=3.0
LIVE_INFER_EVERY=1
LIVE_POSE_INFER_EVERY=1
